    "food_df = (\n",
    "    df_food_merchant\n",
    "    .groupby(\"cuisine_type\")[\"promo_discount\"]\n",
    "    .sum()\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "food_df[\"percentage\"] = (\n",
    "    food_df[\"promo_discount\"]\n",
    "    / food_df[\"promo_discount\"].sum()\n",
    "    * 100\n",
    ")\n",
    "\n",
    "food_df = food_df.sort_values(\n",
    "    \"percentage\",\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "\n",
    "barplot = sns.barplot(\n",
    "    data=food_df,\n",
    "    x=\"cuisine_type\",\n",
    "    y=\"percentage\",\n",
    "    color=\"green\"\n",
    ")\n",
    "\n",
    "for container in barplot.containers:\n",
    "    barplot.bar_label(\n",
    "        container,\n",
    "        fmt=\"%.1f%%\",\n",
    "        padding=3\n",
    "    )\n",
    "\n",
    "plt.title(\"Share of Total Promo Subsidy by Food Category\")\n",
    "plt.xlabel(\"Food Category\")\n",
    "plt.ylabel(\"Share of Total Subsidy (%)\")\n",
    "\n",
    "plt.show()"
   ]
  },
