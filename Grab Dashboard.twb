    <worksheet name='KPI'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='20'>Promo Amount Dashboard</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='grab_food_order_transformed+' name='federated.0x0mi4s1oj5fd3101jl600eshyu8' />
          </datasources>
          <datasource-dependencies datasource='federated.0x0mi4s1oj5fd3101jl600eshyu8'>
            <column caption='Orders' datatype='integer' name='[Calculation_1449452845064199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([order_id])' />
            </column>
            <column caption='Users' datatype='integer' name='[Calculation_1449452845191176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([user_id (grab_user_transformed.csv)])' />
            </column>
            <column caption='Merchants' datatype='integer' name='[Calculation_1449452845281289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([merchant_id (grab_merchant_transformed.csv)])' />
            </column>
            <column caption='Total Promo Used' datatype='integer' name='[Calculation_1449452845412362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promo_discount])' />
            </column>
            <column caption='Grab Unlimited Use' datatype='string' name='[Calculation_1449452850606092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_grab_unlimited] THEN&#10;    &quot;Grab Unlimited Members&quot;&#10;ELSE&#10;    &quot;Non Grab Unlimited&quot;&#10;END' />
            </column>
            <column caption='Time Anomaly Merchant' datatype='integer' name='[Calculation_5606638611030016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [driver_arrived_time] &gt; [completed_time] THEN [merchant_id] END)' />
            </column>
            <column caption='Time Anomaly Order' datatype='integer' name='[Calculation_5606638611296257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [driver_arrived_time] &gt; [completed_time] THEN [order_id] END)' />
            </column>
            <column caption='Failure Rate' datatype='real' name='[Calculation_5606638611443714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id] : &#10;  SUM(IF [is_grab_unlimited] = TRUE AND [order_status] IN (&apos;Cancelled&apos;, &apos;Failed&apos;) THEN 1 ELSE 0 END) &#10;} &#10;/ &#10;{ FIXED [merchant_id] : &#10;  SUM(IF [is_grab_unlimited] = TRUE THEN 1 ELSE 0 END) &#10;}' />
            </column>
            <column caption='Merchant Outlier' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_5606638611517443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5606638611443714] &gt; [Calculation_5606638611611652] &#10;THEN [merchant_id] &#10;ELSE NULL &#10;END' />
            </column>
            <column caption='Q3' datatype='real' name='[Calculation_5606638611611652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : PERCENTILE([Calculation_5606638611443714], 0.75) } &#10;+ &#10;1.5 * (&#10;  { FIXED : PERCENTILE([Calculation_5606638611443714], 0.75) } &#10;  -&#10;{ FIXED : PERCENTILE([Calculation_5606638611443714], 0.25) }&#10;)' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Calculation_5606638611517443]' derivation='Count' name='[cnt:Calculation_5606638611517443:qk]' pivot='key' type='quantitative' />
            <column caption='Completed Time' datatype='datetime' name='[completed_time]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5606638611517443]' derivation='CountD' name='[ctd:Calculation_5606638611517443:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cuisine_type]' derivation='CountD' name='[ctd:cuisine_type:qk]' pivot='key' type='quantitative' />
            <column caption='Cuisine Type' datatype='string' name='[cuisine_type]' role='dimension' type='nominal' />
            <column caption='Driver Arrived Time' datatype='datetime' name='[driver_arrived_time]' role='dimension' type='ordinal' />
            <column caption='Is Grab Unlimited' datatype='boolean' name='[is_grab_unlimited]' role='dimension' type='nominal' />
            <column caption='Merchant Id (Grab Merchant Transformed.Csv)' datatype='string' name='[merchant_id (grab_merchant_transformed.csv)]' role='dimension' type='nominal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Order Time' datatype='datetime' name='[order_time]' role='dimension' type='ordinal' />
            <column caption='Promo Discount' datatype='integer' name='[promo_discount]' role='measure' type='quantitative' />
            <column-instance column='[order_time]' derivation='Month-Trunc' name='[tmn:order_time:ok]' pivot='key' type='ordinal' />
            <column caption='User Id (Grab User Transformed.Csv)' datatype='string' name='[user_id (grab_user_transformed.csv)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1449452845064199]' derivation='User' name='[usr:Calculation_1449452845064199:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1449452845191176]' derivation='User' name='[usr:Calculation_1449452845191176:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1449452845281289]' derivation='User' name='[usr:Calculation_1449452845281289:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1449452845412362]' derivation='User' name='[usr:Calculation_1449452845412362:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5606638611030016]' derivation='User' name='[usr:Calculation_5606638611030016:qk]' pivot='key' type='quantitative' />
